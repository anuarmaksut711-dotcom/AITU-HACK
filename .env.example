# Run python3 scripts/init-local.py to create .env with unique local credentials.
POSTGRES_PASSWORD=replace-with-a-random-password
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=replace-with-a-random-password
WEB_PORT=8787
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Offline transcription; weights are prepared separately with scripts/prepare-stt-model.py.
STT_MODEL_DIR=whisper-large-v3-turbo
STT_CPU_THREADS=4
STT_DIARIZATION_ENABLED=true
STT_DIARIZATION_MODEL_DIR=speaker-diarization
STT_DIARIZATION_THRESHOLD=0.9
STT_MEMORY_LIMIT=4g
STT_CPU_LIMIT=4

# Owned voice rooms. init-local.py generates the API key and signing secret.
LIVEKIT_API_KEY=soyle-local
# Leave LIVEKIT_API_SECRET unset; init-local.py generates and appends it.
LIVEKIT_NODE_IP=127.0.0.1
LIVE_MAX_PARTICIPANTS=12
LIVE_MAX_MINUTES=120
LIVE_ANALYSIS_INTERVAL=12
LIVE_ANALYSIS_REASONING=low

# RAG defaults: OpenAI Luna with max reasoning. See docs/rag.md for local-only deployment.
RAG_OFFLINE=false
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-5.6-luna
RAG_REASONING_EFFORT=max
OPENAI_API_KEY=
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_REVISION=1
RAG_LOCAL_URL=http://host.docker.internal:11434
RAG_LOCAL_API_KEY=

# Local meeting protocol / kanban (independent of the RAG cloud provider)
INTELLIGENCE_MODEL=qwen3:8b
INTELLIGENCE_LOCAL_URL=http://host.docker.internal:11434

# Meeting outcomes and Kanban generation (full transcript sent to the selected provider)
INTELLIGENCE_PROVIDER=openai
INTELLIGENCE_OPENAI_MODEL=gpt-5.6-luna
INTELLIGENCE_REASONING_EFFORT=low
