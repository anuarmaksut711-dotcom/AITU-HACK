{
  "name": "@aimeet/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "openapi-typescript ../../packages/contracts/openapi.json -o src/lib/api.generated.d.ts",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:i18n": "npm run check:i18n && playwright test --config playwright.i18n.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@hookform/resolvers": "5.9.1",
    "@mantine/core": "9.6.1",
    "@mantine/dates": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "dayjs": "1.11.23",
    "get-nonce": "1.0.1",
    "livekit-client": "2.22.3",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
